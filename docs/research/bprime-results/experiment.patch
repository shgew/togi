@@ -0,0 +1,168 @@
+//! Simulation-only B′. This module is absent from a default shipped-package build.
+
+use std::collections::BTreeMap;
+use std::num::NonZeroU32;
+
+use togi_machine::TargetOffset;
+
+use super::{
+    Beta, Cap, CapLimits, Cell, Exposure, Hours, Purpose, Refresh, Slope, UncoveredReason, Witness,
+    offset_value, poisson_upper,
+};
+use crate::Secs;
+use crate::night::Matrix;
+
+/// No pre-onset second is evidence about sustained-day hazard. Subtract per launch,
+/// before aggregating: a thousand short launches must not become one long launch.
+#[must_use]
+pub fn onset_hours(eligible_seconds: u64, warm_up_seconds: u32) -> Hours {
+    let after = eligible_seconds.saturating_sub(u64::from(600_u32.saturating_sub(warm_up_seconds)));
+    #[expect(
+        clippy::cast_precision_loss,
+        reason = "trial seconds are far below the float mantissa"
+    )]
+    let hours = after as f64 / 3600.0;
+    Hours::new(hours).unwrap_or(Hours::ZERO)
+}
+
+/// A deep filler must actually observe time after onset. Its intended duration remains
+/// part of the class identity; short breadth cells are never merged into this class.
+#[must_use]
+pub fn sustain(mut matrix: Matrix) -> Matrix {
+    for planned in &mut matrix.cells {
+        planned.cell.duration = Secs::new(NonZeroU32::new(1800).unwrap_or(NonZeroU32::MIN));
+        planned.cell.sustained = true;
+    }
+    matrix
+}
+
+/// For fixed beta and reference x, the single likelihood has sufficient statistics
+/// `K = sum k_i` and `E_x = sum T_i exp(beta (x-o_i))`; lambda(x)'s upper endpoint is
+/// `chi2(.95, 2(K+1))/(2 E_x)`. This is NOT an exact adaptive confidence interval:
+/// offsets, exposure and beta are selected using the accumulated observations.
+/// Early failures retain their actual stopped exposure, never their intended tail.
+/// Counting even pre-onset failures in K is deliberately conservative; pre-onset
+/// survival supplies no denominator and therefore no positive day-hazard evidence.
+#[must_use]
+pub fn cap<K: Clone + Ord>(
+    classes: &BTreeMap<K, Vec<Cell>>,
+    slope: Slope,
+    edge: Option<TargetOffset>,
+    refresh: Refresh,
+    limits: &CapLimits,
+) -> Cap<K> {
+    super::limit::cap_with(classes, slope, edge, refresh, limits, |class, cells| {
+        witness(class, cells, slope.beta().unwrap_or(Beta::FALLBACK))
+    })
+}
+
+fn witness<K: Clone>(class: &K, cells: &[Cell], beta: Beta) -> Result<Witness<K>, UncoveredReason> {
+    if cells.is_empty() {
+        return Err(UncoveredReason::NoObservations);
+    }
+    if !cells.iter().any(|cell| cell.purpose == Purpose::Mapping) {
+        return Err(UncoveredReason::NonMappingOnly);
+    }
+    let offset = cells
+        .iter()
+        .filter(|cell| {
+            cell.purpose == Purpose::Mapping
+                && cell.exposure == Exposure::Adequate
+                && cell.hours.get() > 0.0
+        })
+        .map(|cell| cell.offset)
+        .min()
+        .ok_or(UncoveredReason::MappingInadequate)?;
+    let mut failures = 0_u32;
+    let mut effective = 0.0_f64;
+    for cell in cells.iter().filter(|cell| cell.purpose == Purpose::Mapping) {
+        failures = failures.saturating_add(cell.failures);
+        let weight = (beta.get() * (offset_value(offset) - offset_value(cell.offset))).exp();
+        effective = (effective + cell.hours.get() * weight).min(f64::MAX);
+    }
+    let hours = Hours::new(effective).unwrap_or(Hours::ZERO);
+    Ok(Witness {
+        class: class.clone(),
+        offset,
+        failures,
+        hours,
+        bound: poisson_upper(failures, hours),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use test_case::test_case;
+
+    fn cell(offset: i64, failures: u32, hours: f64, exposure: Exposure) -> Cell {
+        Cell {
+            offset: TargetOffset::clamped(offset),
+            purpose: Purpose::Mapping,
+            failures,
+            hours: Hours::new(hours).unwrap(),
+            exposure,
+        }
+    }
+
+    #[test]
+    fn one_likelihood_pools_offsets_with_the_slope_exposure_weight() {
+        let beta = Beta::new(2.0_f64.ln()).unwrap();
+        let cells = [
+            cell(-10, 0, 2.0, Exposure::Adequate),
+            cell(-12, 1, 0.25, Exposure::Partial),
+        ];
+        let pooled = witness(&"class", &cells, beta).unwrap();
+        assert_eq!(pooled.offset, TargetOffset::clamped(-10));
+        assert_eq!(pooled.failures, 1);
+        assert_eq!(pooled.hours, Hours::new(3.0).unwrap());
+        assert_eq!(pooled.bound, poisson_upper(1, Hours::new(3.0).unwrap()));
+    }
+
+    #[test]
+    fn early_failures_keep_the_stopped_time_and_count_not_an_intended_tail() {
+        let cells = [
+            cell(-10, 0, 2.0, Exposure::Adequate),
+            cell(-12, 1, 0.0, Exposure::Partial),
+        ];
+        let pooled = witness(&0, &cells, Beta::FALLBACK).unwrap();
+        assert_eq!(pooled.bound, poisson_upper(1, Hours::new(2.0).unwrap()));
+    }
+
+    #[test_case(85, 5, 0.0; "short launch")]
+    #[test_case(595, 5, 0.0; "exact onset")]
+    #[test_case(1795, 5, 1.0 / 3.0; "post onset")]
+    #[test_case(570, 30, 0.0; "role warmup")]
+    fn onset_is_removed_from_each_actual_launch(eligible: u64, warm: u32, expected: f64) {
+        assert_eq!(onset_hours(eligible, warm).get(), expected);
+    }
+
+    #[test]
+    fn short_cells_do_not_become_sustained_day_evidence() {
+        assert_eq!(
+            witness(&0, &[cell(-40, 0, 0.0, Exposure::Adequate)], Beta::FALLBACK),
+            Err(UncoveredReason::MappingInadequate)
+        );
+    }
+
+    #[test]
+    fn pooling_does_not_change_policy_a() {
+        let classes = BTreeMap::from([(
+            0,
+            vec![
+                cell(-10, 0, 2.0, Exposure::Adequate),
+                cell(-12, 1, 0.25, Exposure::Partial),
+            ],
+        )]);
+        let limits = CapLimits::new(NonZeroU32::MIN);
+        let a = super::super::cap(
+            &classes,
+            Slope::FALLBACK,
+            Some(TargetOffset::clamped(-30)),
+            Refresh::Full,
+            &limits,
+        );
+        assert_eq!(a.witnesses[0].hours, Hours::new(2.0).unwrap());
+        assert_eq!(a.witnesses[0].failures, 0);
+    }
+}
