#compdef togi
# zsh completion for togi, generated by togi completion zsh.

_togi_kinds() {
  _sequence compadd - backend backend.retry boot boot.leave_reason boot.saved_entry checking checking.chain checking.cycle checking.step combination command command.reset config config.loaded core core.phase crash crash.detected deadend deepening deepening.round defect defect.answered defect.found failure failure.carried host host.ranking hunt hunt.end hunt.group hunt.skipped hunt.start journal journal.torn mce preflight preflight.check profile profile.applied profile.change profile.restored session session.archived session.baseline session.carried session.context session.notice session.start session.warning shutdown smu smu.error smu.intent smu.readback smu.write state state.rebuilt trial trial.carried trial.end trial.intent trial.progress trial.sample trial.signal trial.start tuner tuner.decision tuner.warning
}

_togi() {
  local curcontext=$curcontext state line
  local -a commands=(
    'completion:Print a shell completion script'
    'events:Render the journal'
    'reset:Reset one core or archive the session'
    'restart-limit:Recover after the tuning service reaches its restart limit'
    'run:Start or resume the session in the foreground'
    'status:Show core failure points, combinations, activity and clean cycles'
    'watch:Show the session as a live dashboard'
  )
  _arguments -C \
    '--config=:path:_files' \
    '--state-dir=:path:_files' \
    '--version' \
    '1:command:->command' \
    '*::argument:->argument'
  case $state in
  command)
    _describe -t commands 'togi command' commands
    ;;
  argument)
    case $line[1] in
    completion)
      _arguments \
        '--state-dir=:path:_files' \
        '1:argument:(bash zsh fish nushell)'
      ;;
    events)
      _arguments \
        '--core=:N: ' \
        '--json' \
        '--kind=:kinds:_togi_kinds' \
        '--since=:time: ' \
        '--state-dir=:path:_files' \
        '--trial=:ID: ' \
        '--until=:time: '
      ;;
    reset)
      _arguments \
        '--all' \
        '--config=:path:_files' \
        '--core=:N: ' \
        '--state-dir=:path:_files'
      ;;
    restart-limit)
      _arguments \
        '--state-dir=:path:_files' \
        '--tuning-boot=:file:_files'
      ;;
    run)
      _arguments \
        '--config=:path:_files' \
        '--cycles=:N: ' \
        '--no-tui' \
        '--state-dir=:path:_files' \
        '--tuning-boot=:file:_files'
      ;;
    status)
      _arguments \
        '--state-dir=:path:_files'
      ;;
    watch)
      _arguments \
        '--height=:rows: ' \
        '--state-dir=:path:_files' \
        '--width=:columns: '
      ;;
    esac
    ;;
  esac
}

if [[ $zsh_eval_context[-1] == loadautofunc ]]; then
  _togi "$@"
else
  compdef _togi togi
fi
