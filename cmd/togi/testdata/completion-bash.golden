# bash completion for togi, generated by togi completion bash.

_togi_words() {
    local word
    for word in "$@"; do
        if [[ $word == "$cur"* ]]; then
            COMPREPLY+=("$word")
        fi
    done
}

_togi_files() {
    local file
    compopt -o filenames 2>/dev/null
    while IFS= read -r file; do
        COMPREPLY+=("$file")
    done < <(compgen -f -- "$cur")
}

_togi_kinds() {
    local prefix= word=$cur kind
    if [[ $cur == *,* ]]; then
        prefix=${cur%,*},
        word=${cur##*,}
    fi
    for kind in backend backend.retry boot boot.leave_reason boot.saved_entry checking checking.chain checking.cycle checking.step combination command command.reset config config.loaded core core.phase crash crash.detected deadend deepening deepening.round defect defect.answered defect.found failure failure.carried host host.ranking hunt hunt.end hunt.group hunt.skipped hunt.start journal journal.torn mce preflight preflight.check profile profile.applied profile.change profile.restored session session.archived session.baseline session.carried session.context session.notice session.start session.warning shutdown smu smu.error smu.intent smu.readback smu.write state state.rebuilt trial trial.carried trial.end trial.intent trial.progress trial.sample trial.signal trial.start tuner tuner.decision tuner.warning; do
        if [[ $kind == "$word"* ]]; then
            COMPREPLY+=("$prefix$kind")
        fi
    done
}

_togi() {
    local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]} cmd= i
    COMPREPLY=()
    if [[ $cur == = ]]; then
        cur=
    elif [[ $prev == = ]]; then
        prev=${COMP_WORDS[COMP_CWORD-2]}
    fi
    for ((i = 1; i < COMP_CWORD; i++)); do
        case ${COMP_WORDS[i]} in
        --config|--state-dir)
            ((i++))
            if ((i < COMP_CWORD)) && [[ ${COMP_WORDS[i]} =~ ^=+$ ]]; then
                ((i++))
            fi
            while ((i + 1 < COMP_CWORD)) && [[ ${COMP_WORDS[i+1]} =~ ^=+$ ]]; do
                ((i += 2))
            done
            ;;
        -*) ;;
        *)
            cmd=${COMP_WORDS[i]}
            break
            ;;
        esac
    done
    case $cmd in
    "")
        case $prev in
        --config|--state-dir)
            _togi_files
            return
            ;;
        esac
        if [[ $cur == -* ]]; then
            _togi_words --config --state-dir --version
        else
            _togi_words completion doctor events reset restart-limit run status watch
        fi
        ;;
    completion)
        case $prev in
        --state-dir)
            _togi_files
            return
            ;;
        esac
        if [[ $cur == -* ]]; then
            _togi_words --state-dir
        else
            _togi_words bash zsh fish nushell
        fi
        ;;
    doctor)
        case $prev in
        --config|--state-dir)
            _togi_files
            return
            ;;
        esac
        _togi_words --config --state-dir
        ;;
    events)
        case $prev in
        --state-dir)
            _togi_files
            return
            ;;
        --kind)
            _togi_kinds
            return
            ;;
        --core|--since|--trial|--until)
            return
            ;;
        esac
        _togi_words --core --json --kind --since --state-dir --trial --until
        ;;
    reset)
        case $prev in
        --config|--state-dir)
            _togi_files
            return
            ;;
        --core)
            return
            ;;
        esac
        _togi_words --all --config --core --state-dir
        ;;
    restart-limit)
        case $prev in
        --state-dir|--tuning-boot)
            _togi_files
            return
            ;;
        esac
        _togi_words --state-dir --tuning-boot
        ;;
    run)
        case $prev in
        --config|--state-dir|--tuning-boot)
            _togi_files
            return
            ;;
        --cycles)
            return
            ;;
        esac
        _togi_words --config --cycles --no-tui --state-dir --tuning-boot
        ;;
    status)
        case $prev in
        --state-dir)
            _togi_files
            return
            ;;
        esac
        _togi_words --state-dir
        ;;
    watch)
        case $prev in
        --state-dir)
            _togi_files
            return
            ;;
        --height|--width)
            return
            ;;
        esac
        _togi_words --height --state-dir --width
        ;;
    esac
}

complete -F _togi togi
