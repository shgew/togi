# fish completion for togi, generated by togi completion fish.

function __togi_kinds
    set -l token (commandline -ct)
    set token (string replace -r -- '^--?[^=]*=' '' "$token")
    set -l prefix (string replace -r -- '[^,]*$' '' "$token")
    for kind in backend backend.retry boot boot.leave_reason boot.saved_entry checking checking.chain checking.cycle checking.step combination command command.reset config config.loaded core core.phase crash crash.detected deadend deepening deepening.round defect defect.answered defect.found failure failure.carried host host.ranking hunt hunt.end hunt.group hunt.skipped hunt.start journal journal.torn mce preflight preflight.check profile profile.applied profile.change profile.restored session session.archived session.baseline session.carried session.context session.notice session.start session.warning shutdown smu smu.error smu.intent smu.readback smu.write state state.rebuilt trial trial.carried trial.end trial.intent trial.progress trial.sample trial.signal trial.start tuner tuner.decision tuner.warning
        echo "$prefix$kind"
    end
end

set -l togi_commands completion events reset restart-limit run status watch
complete -c togi -f
complete -c togi -n "not __fish_seen_subcommand_from $togi_commands" -a completion -d 'Print a shell completion script'
complete -c togi -n "not __fish_seen_subcommand_from $togi_commands" -a events -d 'Render the journal'
complete -c togi -n "not __fish_seen_subcommand_from $togi_commands" -a reset -d 'Reset one core or archive the session'
complete -c togi -n "not __fish_seen_subcommand_from $togi_commands" -a restart-limit -d 'Recover after the tuning service reaches its restart limit'
complete -c togi -n "not __fish_seen_subcommand_from $togi_commands" -a run -d 'Start or resume the session in the foreground'
complete -c togi -n "not __fish_seen_subcommand_from $togi_commands" -a status -d 'Show core failure points, combinations, activity and clean cycles'
complete -c togi -n "not __fish_seen_subcommand_from $togi_commands" -a watch -d 'Show the session as a live dashboard'
complete -c togi -n "not __fish_seen_subcommand_from $togi_commands" -l config -r -F
complete -c togi -n "not __fish_seen_subcommand_from $togi_commands" -l state-dir -r -F
complete -c togi -n "not __fish_seen_subcommand_from $togi_commands" -l version
complete -c togi -n "__fish_seen_subcommand_from completion" -l state-dir -r -F
complete -c togi -n "__fish_seen_subcommand_from completion" -a 'bash zsh fish nushell'
complete -c togi -n "__fish_seen_subcommand_from events" -l core -x
complete -c togi -n "__fish_seen_subcommand_from events" -l json
complete -c togi -n "__fish_seen_subcommand_from events" -l kind -x -a '(__togi_kinds)'
complete -c togi -n "__fish_seen_subcommand_from events" -l since -x
complete -c togi -n "__fish_seen_subcommand_from events" -l state-dir -r -F
complete -c togi -n "__fish_seen_subcommand_from events" -l trial -x
complete -c togi -n "__fish_seen_subcommand_from events" -l until -x
complete -c togi -n "__fish_seen_subcommand_from reset" -l all
complete -c togi -n "__fish_seen_subcommand_from reset" -l config -r -F
complete -c togi -n "__fish_seen_subcommand_from reset" -l core -x
complete -c togi -n "__fish_seen_subcommand_from reset" -l state-dir -r -F
complete -c togi -n "__fish_seen_subcommand_from restart-limit" -l state-dir -r -F
complete -c togi -n "__fish_seen_subcommand_from restart-limit" -l tuning-boot -r -F
complete -c togi -n "__fish_seen_subcommand_from run" -l config -r -F
complete -c togi -n "__fish_seen_subcommand_from run" -l cycles -x
complete -c togi -n "__fish_seen_subcommand_from run" -l no-tui
complete -c togi -n "__fish_seen_subcommand_from run" -l state-dir -r -F
complete -c togi -n "__fish_seen_subcommand_from run" -l tuning-boot -r -F
complete -c togi -n "__fish_seen_subcommand_from status" -l state-dir -r -F
complete -c togi -n "__fish_seen_subcommand_from watch" -l height -x
complete -c togi -n "__fish_seen_subcommand_from watch" -l state-dir -r -F
complete -c togi -n "__fish_seen_subcommand_from watch" -l width -x
