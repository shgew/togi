# fish completion for togi, generated by togi completion fish.

function __togi_kinds
    set -l token (commandline -ct)
    set token (string replace -r -- '^--?[^=]*=' '' "$token")
    set -l prefix (string replace -r -- '[^,]*$' '' "$token")
    for kind in backend backend.retry boot boot.leave_reason boot.saved_entry checking checking.chain checking.cycle checking.step combination command command.reset config config.loaded core core.phase crash crash.detected deadend deepening deepening.round defect defect.answered defect.found failure failure.carried host host.ranking hunt hunt.end hunt.group hunt.skipped hunt.start journal journal.torn mce preflight preflight.check profile profile.applied profile.change profile.restored session session.archived session.baseline session.carried session.context session.notice session.start session.warning shutdown smu smu.error smu.intent smu.readback smu.write state state.rebuilt trial trial.carried trial.end trial.intent trial.progress trial.sample trial.signal trial.start tuner tuner.decision tuner.warning
        echo "$prefix$kind"
    end
end

function __togi_command_is
    # commandline -x, which expands variables, is fish 4 only.
    set -l tokens (commandline -xpc 2>/dev/null)
    or set tokens (commandline -opc)
    set -e tokens[1]
    set -l command
    set -l skip
    for token in $tokens
        if test -n "$skip"
            set skip
            continue
        end
        switch $token
            case --config --state-dir
                set skip 1
            case '-*'
            case '*'
                set command $token
                break
        end
    end
    test "$command" = "$argv[1]"
end

complete -c togi -f
complete -c togi -n "__togi_command_is ''" -a completion -d 'Print a shell completion script'
complete -c togi -n "__togi_command_is ''" -a doctor -d 'Check whether this machine is ready for a run, writing nothing'
complete -c togi -n "__togi_command_is ''" -a events -d 'Render the journal'
complete -c togi -n "__togi_command_is ''" -a reset -d 'Reset one core or archive the session'
complete -c togi -n "__togi_command_is ''" -a restart-limit -d 'Recover after the tuning service reaches its restart limit'
complete -c togi -n "__togi_command_is ''" -a run -d 'Start or resume the session in the foreground'
complete -c togi -n "__togi_command_is ''" -a status -d 'Show core failure points, combinations, activity and clean cycles'
complete -c togi -n "__togi_command_is ''" -a watch -d 'Show the session as a live dashboard'
complete -c togi -n "__togi_command_is ''" -l config -r -F
complete -c togi -n "__togi_command_is ''" -l state-dir -r -F
complete -c togi -n "__togi_command_is ''" -l version
complete -c togi -n "__togi_command_is completion" -l state-dir -r -F
complete -c togi -n "__togi_command_is completion" -a 'bash zsh fish nushell'
complete -c togi -n "__togi_command_is doctor" -l config -r -F
complete -c togi -n "__togi_command_is doctor" -l state-dir -r -F
complete -c togi -n "__togi_command_is events" -l core -x
complete -c togi -n "__togi_command_is events" -l json
complete -c togi -n "__togi_command_is events" -l kind -x -a '(__togi_kinds)'
complete -c togi -n "__togi_command_is events" -l since -x
complete -c togi -n "__togi_command_is events" -l state-dir -r -F
complete -c togi -n "__togi_command_is events" -l trial -x
complete -c togi -n "__togi_command_is events" -l until -x
complete -c togi -n "__togi_command_is reset" -l all
complete -c togi -n "__togi_command_is reset" -l config -r -F
complete -c togi -n "__togi_command_is reset" -l core -x
complete -c togi -n "__togi_command_is reset" -l state-dir -r -F
complete -c togi -n "__togi_command_is restart-limit" -l state-dir -r -F
complete -c togi -n "__togi_command_is restart-limit" -l tuning-boot -r -F
complete -c togi -n "__togi_command_is run" -l config -r -F
complete -c togi -n "__togi_command_is run" -l cycles -x
complete -c togi -n "__togi_command_is run" -l no-tui
complete -c togi -n "__togi_command_is run" -l state-dir -r -F
complete -c togi -n "__togi_command_is run" -l tuning-boot -r -F
complete -c togi -n "__togi_command_is status" -l state-dir -r -F
complete -c togi -n "__togi_command_is watch" -l height -x
complete -c togi -n "__togi_command_is watch" -l state-dir -r -F
complete -c togi -n "__togi_command_is watch" -l width -x
