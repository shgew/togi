---
source: crates/togi/tests/cli/main.rs
expression: "completion(\"fish\")"
---
# Print an optspec for argparse to handle cmd's options that are independent of any subcommand.
function __fish_togi_global_optspecs
    string join \n state-dir= h/help V/version
end

function __fish_togi_needs_command
    # Figure out if the current invocation already has a command.
    set -l cmd (commandline -opc)
    set -e cmd[1]
    argparse -s (__fish_togi_global_optspecs) -- $cmd 2>/dev/null
    or return
    if set -q argv[1]
        # Also print the command, so this can be used to figure out what it is.
        echo $argv[1]
        return 1
    end
    return 0
end

function __fish_togi_using_subcommand
    set -l cmd (__fish_togi_needs_command)
    test -z "$cmd"
    and return 1
    contains -- $cmd[1] $argv
end

complete -c togi -n "__fish_togi_needs_command" -l state-dir -d 'State directory' -r -f -a "(__fish_complete_directories)"
complete -c togi -n "__fish_togi_needs_command" -s h -l help -d 'Print help'
complete -c togi -n "__fish_togi_needs_command" -s V -l version -d 'Print version'
complete -c togi -n "__fish_togi_needs_command" -f -a "completion" -d 'Print a shell completion script'
complete -c togi -n "__fish_togi_needs_command" -f -a "events" -d 'Print the journal, one readable line per event'
complete -c togi -n "__fish_togi_needs_command" -f -a "status" -d 'Show the session at a glance'
complete -c togi -n "__fish_togi_needs_command" -f -a "watch" -d 'Show the session as a read-only dashboard'
complete -c togi -n "__fish_togi_needs_command" -f -a "help" -d 'Print this message or the help of the given subcommand(s)'
complete -c togi -n "__fish_togi_using_subcommand completion" -l state-dir -d 'State directory' -r -f -a "(__fish_complete_directories)"
complete -c togi -n "__fish_togi_using_subcommand completion" -s h -l help -d 'Print help (see more with \'--help\')'
complete -c togi -n "__fish_togi_using_subcommand events" -l core -d 'Only events naming core N, and the outcomes of trials that load it' -r
complete -c togi -n "__fish_togi_using_subcommand events" -l kind -d 'Only these comma-separated known kinds, or groups such as trial for every trial.* kind' -r -f -a "backend\t''
backend.retry\t''
boot\t''
boot.leave_reason\t''
boot.saved_entry\t''
checking\t''
checking.chain\t''
checking.cycle\t''
checking.step\t''
combination\t''
command\t''
command.reset\t''
config\t''
config.loaded\t''
core\t''
core.phase\t''
crash\t''
crash.detected\t''
deadend\t''
deepening\t''
deepening.round\t''
defect\t''
defect.answered\t''
defect.found\t''
failure\t''
failure.carried\t''
host\t''
host.ranking\t''
hunt\t''
hunt.end\t''
hunt.group\t''
hunt.skipped\t''
hunt.start\t''
journal\t''
journal.torn\t''
mce\t''
preflight\t''
preflight.check\t''
profile\t''
profile.applied\t''
profile.change\t''
profile.restored\t''
session\t''
session.archived\t''
session.baseline\t''
session.carried\t''
session.context\t''
session.notice\t''
session.start\t''
session.warning\t''
shutdown\t''
smu\t''
smu.error\t''
smu.intent\t''
smu.readback\t''
smu.write\t''
state\t''
state.rebuilt\t''
trial\t''
trial.carried\t''
trial.end\t''
trial.intent\t''
trial.progress\t''
trial.sample\t''
trial.signal\t''
trial.start\t''
tuner\t''
tuner.decision\t''
tuner.warning\t''"
complete -c togi -n "__fish_togi_using_subcommand events" -l trial -d 'Only events of trial ID' -r
complete -c togi -n "__fish_togi_using_subcommand events" -l since -d 'Only events at or after this RFC 3339 time' -r
complete -c togi -n "__fish_togi_using_subcommand events" -l until -d 'Only events before this RFC 3339 time' -r
complete -c togi -n "__fish_togi_using_subcommand events" -l state-dir -d 'State directory' -r -f -a "(__fish_complete_directories)"
complete -c togi -n "__fish_togi_using_subcommand events" -l json -d 'Print raw, uncolored JSON events'
complete -c togi -n "__fish_togi_using_subcommand events" -s h -l help -d 'Print help (see more with \'--help\')'
complete -c togi -n "__fish_togi_using_subcommand status" -l state-dir -d 'State directory' -r -f -a "(__fish_complete_directories)"
complete -c togi -n "__fish_togi_using_subcommand status" -s h -l help -d 'Print help (see more with \'--help\')'
complete -c togi -n "__fish_togi_using_subcommand watch" -l width -d 'Frame width in columns when stdout is not a terminal' -r
complete -c togi -n "__fish_togi_using_subcommand watch" -l height -d 'Frame height in rows when stdout is not a terminal' -r
complete -c togi -n "__fish_togi_using_subcommand watch" -l state-dir -d 'State directory' -r -f -a "(__fish_complete_directories)"
complete -c togi -n "__fish_togi_using_subcommand watch" -s h -l help -d 'Print help (see more with \'--help\')'
complete -c togi -n "__fish_togi_using_subcommand help; and not __fish_seen_subcommand_from completion events status watch help" -f -a "completion" -d 'Print a shell completion script'
complete -c togi -n "__fish_togi_using_subcommand help; and not __fish_seen_subcommand_from completion events status watch help" -f -a "events" -d 'Print the journal, one readable line per event'
complete -c togi -n "__fish_togi_using_subcommand help; and not __fish_seen_subcommand_from completion events status watch help" -f -a "status" -d 'Show the session at a glance'
complete -c togi -n "__fish_togi_using_subcommand help; and not __fish_seen_subcommand_from completion events status watch help" -f -a "watch" -d 'Show the session as a read-only dashboard'
complete -c togi -n "__fish_togi_using_subcommand help; and not __fish_seen_subcommand_from completion events status watch help" -f -a "help" -d 'Print this message or the help of the given subcommand(s)'
