---
source: crates/togi/tests/cli/main.rs
expression: "completion(\"fish\")"
---
# Print an optspec for argparse to handle cmd's options that are independent of any subcommand.
function __fish_togi_global_optspecs
    string join \n state-dir= h/help V/version
end

function __fish_togi_needs_command
    # Figure out if the current invocation already has a command.
    set -l cmd (commandline -opc)
    set -e cmd[1]
    argparse -s (__fish_togi_global_optspecs) -- $cmd 2>/dev/null
    or return
    if set -q argv[1]
        # Also print the command, so this can be used to figure out what it is.
        echo $argv[1]
        return 1
    end
    return 0
end

function __fish_togi_using_subcommand
    set -l cmd (__fish_togi_needs_command)
    test -z "$cmd"
    and return 1
    contains -- $cmd[1] $argv
end

complete -c togi -n "__fish_togi_needs_command" -l state-dir -d 'State directory' -r -f -a "(__fish_complete_directories)"
complete -c togi -n "__fish_togi_needs_command" -s h -l help -d 'Print help'
complete -c togi -n "__fish_togi_needs_command" -s V -l version -d 'Print version'
complete -c togi -n "__fish_togi_needs_command" -f -a "run" -d 'Start or resume the tuning session in the foreground'
complete -c togi -n "__fish_togi_needs_command" -f -a "completion" -d 'Print a shell completion script'
complete -c togi -n "__fish_togi_needs_command" -f -a "help" -d 'Print this message or the help of the given subcommand(s)'
complete -c togi -n "__fish_togi_using_subcommand run" -l config -d 'JSON configuration file [default: /etc/togi/config.json]' -r -F
complete -c togi -n "__fish_togi_using_subcommand run" -l cycles -d 'Stop after N clean cycles, each a passed full cycle ending at or after phase 2\'s confirmation cycle (default endless)' -r
complete -c togi -n "__fish_togi_using_subcommand run" -l tuning-boot -d 'Run as the tuning boot service: persist a leave reason before clearing the saved boot entry in this GRUB environment file, and reboot after a boot loop' -r -F
complete -c togi -n "__fish_togi_using_subcommand run" -l state-dir -d 'State directory' -r -f -a "(__fish_complete_directories)"
complete -c togi -n "__fish_togi_using_subcommand run" -l first-result -d 'Stop once the BIOS profile is first confirmed, after phase 1\'s passed cycle and before phase 2 moves a core'
complete -c togi -n "__fish_togi_using_subcommand run" -l no-tui -d 'Print one line per event instead of the dashboard on a terminal'
complete -c togi -n "__fish_togi_using_subcommand run" -s h -l help -d 'Print help (see more with \'--help\')'
complete -c togi -n "__fish_togi_using_subcommand completion" -l state-dir -d 'State directory' -r -f -a "(__fish_complete_directories)"
complete -c togi -n "__fish_togi_using_subcommand completion" -s h -l help -d 'Print help (see more with \'--help\')'
complete -c togi -n "__fish_togi_using_subcommand help; and not __fish_seen_subcommand_from run completion help" -f -a "run" -d 'Start or resume the tuning session in the foreground'
complete -c togi -n "__fish_togi_using_subcommand help; and not __fish_seen_subcommand_from run completion help" -f -a "completion" -d 'Print a shell completion script'
complete -c togi -n "__fish_togi_using_subcommand help; and not __fish_seen_subcommand_from run completion help" -f -a "help" -d 'Print this message or the help of the given subcommand(s)'
