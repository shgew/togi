---
source: crates/togi/tests/cli/mod.rs
expression: "completion(\"fish\")"
---
# Print an optspec for argparse to handle cmd's options that are independent of any subcommand.
function __fish_togi_global_optspecs
    string join \n state-dir= h/help V/version
end

function __fish_togi_needs_command
    # Figure out if the current invocation already has a command.
    set -l cmd (commandline -opc)
    set -e cmd[1]
    argparse -s (__fish_togi_global_optspecs) -- $cmd 2>/dev/null
    or return
    if set -q argv[1]
        # Also print the command, so this can be used to figure out what it is.
        echo $argv[1]
        return 1
    end
    return 0
end

function __fish_togi_using_subcommand
    set -l cmd (__fish_togi_needs_command)
    test -z "$cmd"
    and return 1
    contains -- $cmd[1] $argv
end

complete -c togi -n "__fish_togi_needs_command" -l state-dir -d 'State directory' -r -f -a "(__fish_complete_directories)"
complete -c togi -n "__fish_togi_needs_command" -s h -l help -d 'Print help'
complete -c togi -n "__fish_togi_needs_command" -s V -l version -d 'Print version'
complete -c togi -n "__fish_togi_needs_command" -f -a "run" -d 'Start or resume the night\'s tuning session in the foreground'
complete -c togi -n "__fish_togi_needs_command" -f -a "day" -d 'Apply the permitted profile, observe daily use, pause or freeze, and report crashes'
complete -c togi -n "__fish_togi_needs_command" -f -a "completion" -d 'Print a shell completion script'
complete -c togi -n "__fish_togi_needs_command" -f -a "doctor" -d 'Check whether this machine is ready for a run'
complete -c togi -n "__fish_togi_needs_command" -f -a "night" -d 'Reboot into the tuning boot for the night'
complete -c togi -n "__fish_togi_needs_command" -f -a "reset" -d 'Archive the whole session'
complete -c togi -n "__fish_togi_needs_command" -f -a "restart-limit" -d 'Recover after the tuning service reaches its restart limit'
complete -c togi -n "__fish_togi_needs_command" -f -a "emergency-stop" -d 'Internal emergency recovery that stops leftover trials and sets every core to offset 0'
complete -c togi -n "__fish_togi_needs_command" -f -a "status" -d 'Show the session at a glance'
complete -c togi -n "__fish_togi_needs_command" -f -a "watch" -d 'Show the session dashboard with rootless day controls'
complete -c togi -n "__fish_togi_needs_command" -f -a "help" -d 'Print this message or the help of the given subcommand(s)'
complete -c togi -n "__fish_togi_using_subcommand run" -l config -d 'JSON configuration file [default: /etc/togi/config.json]' -r -F
complete -c togi -n "__fish_togi_using_subcommand run" -l tuning-boot -d 'Run as the tuning boot service: use the GRUB environment to persist a leave reason before restoring the day\'s boot selection, and reboot after a boot loop' -r -F
complete -c togi -n "__fish_togi_using_subcommand run" -l state-dir -d 'State directory' -r -f -a "(__fish_complete_directories)"
complete -c togi -n "__fish_togi_using_subcommand run" -s h -l help -d 'Print help (see more with \'--help\')'
