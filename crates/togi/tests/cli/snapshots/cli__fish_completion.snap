---
source: crates/togi/tests/cli/mod.rs
expression: "completion(\"fish\")"
---
function __togi_kinds
    set -l token (commandline -ct)
    set token (string replace -r -- '^--?[^=]*=' '' "$token")
    set -l prefix (string replace -r -- '[^,]*$' '' "$token")
    for kind in backend backend.retry boot boot.leave_reason boot.saved_entry ccd ccd.cap ccd.edge checking checking.chain checking.cycle checking.step combination command command.reset config config.loaded core core.phase crash crash.detected day day.answer day.applied day.boot_start day.checkpoint day.clean_stop day.event day.fault day.freeze day.hold day.imported day.interval day.offsets_changed day.record day.step day.unclean_end day.veto deadend deepening deepening.round defect defect.answered defect.found exposure exposure.observed failure failure.carried host host.ranking hunt hunt.end hunt.group hunt.skipped hunt.start journal journal.torn mce night night.plan night.qualification night.reproduction preflight preflight.check profile profile.applied profile.change profile.restored session session.archived session.baseline session.carried session.context session.imported session.notice session.start session.warning shutdown smu smu.error smu.intent smu.readback smu.write state state.rebuilt task task.start trial trial.carried trial.end trial.intent trial.progress trial.sample trial.signal trial.start tuner tuner.decision tuner.warning
        echo "$prefix$kind"
    end
end

# Print an optspec for argparse to handle cmd's options that are independent of any subcommand.
function __fish_togi_global_optspecs
    string join \n state-dir= h/help V/version
end

function __fish_togi_needs_command
    # Figure out if the current invocation already has a command.
    set -l cmd (commandline -opc)
    set -e cmd[1]
    argparse -s (__fish_togi_global_optspecs) -- $cmd 2>/dev/null
    or return
    if set -q argv[1]
        # Also print the command, so this can be used to figure out what it is.
        echo $argv[1]
        return 1
    end
    return 0
end

function __fish_togi_using_subcommand
    set -l cmd (__fish_togi_needs_command)
    test -z "$cmd"
    and return 1
    contains -- $cmd[1] $argv
end

complete -c togi -n "__fish_togi_needs_command" -l state-dir -d 'State directory' -r -f -a "(__fish_complete_directories)"
complete -c togi -n "__fish_togi_needs_command" -s h -l help -d 'Print help'
complete -c togi -n "__fish_togi_needs_command" -s V -l version -d 'Print version'
complete -c togi -n "__fish_togi_needs_command" -f -a "run" -d 'Start or resume the night\'s tuning session in the foreground'
complete -c togi -n "__fish_togi_needs_command" -f -a "day" -d 'Observe daily use, answer what happened after an unclean end, or record a crash togi missed'
complete -c togi -n "__fish_togi_needs_command" -f -a "completion" -d 'Print a shell completion script'
complete -c togi -n "__fish_togi_needs_command" -f -a "doctor" -d 'Check whether this machine is ready for a run'
complete -c togi -n "__fish_togi_needs_command" -f -a "events" -d 'Print the journal, one readable line per event'
complete -c togi -n "__fish_togi_needs_command" -f -a "night" -d 'Reboot into the tuning boot for the night'
complete -c togi -n "__fish_togi_needs_command" -f -a "night-end" -d 'Restore the day\'s boot selection'
