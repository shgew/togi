complete -c togi -n "__fish_togi_needs_command" -f -a "restart-limit" -d 'Recover after the tuning service reaches its restart limit'
complete -c togi -n "__fish_togi_needs_command" -f -a "emergency-stop" -d 'Internal emergency recovery that stops leftover trials and sets every core to offset 0'
complete -c togi -n "__fish_togi_needs_command" -f -a "status" -d 'Show the session at a glance'
complete -c togi -n "__fish_togi_needs_command" -f -a "watch" -d 'Show the session as a read-only dashboard'
complete -c togi -n "__fish_togi_needs_command" -f -a "help" -d 'Print this message or the help of the given subcommand(s)'
complete -c togi -n "__fish_togi_using_subcommand run" -l config -d 'JSON configuration file [default: /etc/togi/config.json]' -r -F
complete -c togi -n "__fish_togi_using_subcommand run" -l tuning-boot -d 'Run as the tuning boot service: persist a leave reason before restoring the day\'s boot selection, using a GRUB environment or /etc/togi/night.json, and reboot after a boot loop' -r -F
