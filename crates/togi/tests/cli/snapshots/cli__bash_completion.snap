            togi__subcmd__help,watch)
                cmd="togi__subcmd__help__subcmd__watch"
                ;;
            togi__subcmd__help__subcmd__day,answer)
                cmd="togi__subcmd__help__subcmd__day__subcmd__answer"
                ;;
            togi__subcmd__help__subcmd__day,notify)
                cmd="togi__subcmd__help__subcmd__day__subcmd__notify"
                ;;
            *)
                ;;
        esac
    done

    case "${cmd}" in
        togi)
            opts="-h -V --state-dir --help --version run day completion doctor events reset restart-limit emergency-stop status watch help"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 1 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                --state-dir)
                    COMPREPLY=()
                    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
                        compopt -o plusdirs
                    fi
                    return 0
                    ;;
                *)
                    COMPREPLY=()
                    ;;
            esac
            COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            return 0
            ;;
        togi__subcmd__completion)
            opts="-h --state-dir --help bash zsh fish nushell"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 2 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                --state-dir)
                    COMPREPLY=()
                    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
                        compopt -o plusdirs
