---
source: crates/togi/tests/cli/main.rs
expression: "completion(\"bash\")"
---
_togi() {
    local i cur prev opts cmd
    COMPREPLY=()
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
        cur="$2"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
    fi
    prev="$3"
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"
    do
        case "${cmd},${i}" in
            ",$1")
                cmd="togi"
                ;;
            togi,completion)
                cmd="togi__subcmd__completion"
                ;;
            togi,day)
                cmd="togi__subcmd__day"
                ;;
            togi,doctor)
                cmd="togi__subcmd__doctor"
                ;;
            togi,emergency-stop)
                cmd="togi__subcmd__emergency__subcmd__stop"
                ;;
            togi,events)
                cmd="togi__subcmd__events"
                ;;
            togi,help)
                cmd="togi__subcmd__help"
                ;;
            togi,reset)
                cmd="togi__subcmd__reset"
                ;;
            togi,restart-limit)
                cmd="togi__subcmd__restart__subcmd__limit"
                ;;
            togi,run)
                cmd="togi__subcmd__run"
                ;;
            togi,status)
                cmd="togi__subcmd__status"
                ;;
            togi,watch)
                cmd="togi__subcmd__watch"
                ;;
            togi__subcmd__day,answer)
                cmd="togi__subcmd__day__subcmd__answer"
                ;;
            togi__subcmd__day,help)
                cmd="togi__subcmd__day__subcmd__help"
                ;;
            togi__subcmd__day,notify)
                cmd="togi__subcmd__day__subcmd__notify"
                ;;
            togi__subcmd__day__subcmd__help,answer)
                cmd="togi__subcmd__day__subcmd__help__subcmd__answer"
                ;;
            togi__subcmd__day__subcmd__help,help)
                cmd="togi__subcmd__day__subcmd__help__subcmd__help"
                ;;
            togi__subcmd__day__subcmd__help,notify)
                cmd="togi__subcmd__day__subcmd__help__subcmd__notify"
                ;;
            togi__subcmd__help,completion)
                cmd="togi__subcmd__help__subcmd__completion"
                ;;
            togi__subcmd__help,day)
                cmd="togi__subcmd__help__subcmd__day"
                ;;
            togi__subcmd__help,doctor)
                cmd="togi__subcmd__help__subcmd__doctor"
                ;;
            togi__subcmd__help,emergency-stop)
                cmd="togi__subcmd__help__subcmd__emergency__subcmd__stop"
