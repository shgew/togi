---
source: crates/togi/tests/cli/mod.rs
expression: "completion(\"nushell\")"
---
module completions {

  # Finds and tests per-core Curve Optimizer offsets on Zen 5 desktop CPUs
  export extern togi [
    --state-dir: directory    # State directory
    --help(-h)                # Print help
    --version(-V)             # Print version
  ]

  # Start or resume the night's tuning session in the foreground
  export extern "togi run" [
    --config: path            # JSON configuration file [default: /etc/togi/config.json]
    --tuning-boot: path       # Run as the tuning boot service: persist a leave reason before restoring the day's boot selection, using a GRUB environment or /etc/togi/night.json, and reboot after a boot loop
    --no-tui                  # Print one line per event instead of the dashboard on a terminal
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Observe daily use, answer what happened after an unclean end, or record a crash togi missed
  export extern "togi day" [
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Answer an unclean end; a later answer replaces the previous answer
  export extern "togi day answer" [
    --state-dir: directory    # State directory
    --help(-h)                # Print help
    boot: string              # Full boot ID shown in the pending question
    answer: string            # What happened: frozen, graphics, power-off or unsure
  ]

  # Send pending questions and the morning evidence report to this graphical session
  export extern "togi day notify" [
    --state-dir: directory    # State directory
    --help(-h)                # Print help
  ]

  # Record a crash togi did not observe
  export extern "togi day record" [
    --boot: string            # The crashed boot: the ID of a boot with a recorded unclean end
    --unobserved-at: string   # When a crash happened that has no recorded unclean end
    --offset: string          # An offset the crashed boot ran: all=N, ccdI=N or coreI=N; repeat for more
    --entered-at: string      # When the offsets given with --offset were entered in firmware setup
    --running: string         # What was running: idle, desktop, build, game, other or unknown
    --note: string            # Free text about what was running
    --yes                     # Append without asking first at a terminal
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Print this message or the help of the given subcommand(s)
  export extern "togi day help" [
  ]

  # Answer an unclean end; a later answer replaces the previous answer
  export extern "togi day help answer" [
  ]

  # Send pending questions and the morning evidence report to this graphical session
  export extern "togi day help notify" [
  ]

  # Record a crash togi did not observe
  export extern "togi day help record" [
  ]

  # Print this message or the help of the given subcommand(s)
  export extern "togi day help help" [
  ]

  def "nu-complete togi completion shell" [] {
    [ "bash" "zsh" "fish" "nushell" ]
  }

  # Print a shell completion script
  export extern "togi completion" [
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
    shell: string@"nu-complete togi completion shell" # The shell to print the script for
  ]

  # Check whether this machine is ready for a run
  export extern "togi doctor" [
    --config: path            # JSON configuration file [default: /etc/togi/config.json]
    --day                     # Check day-observation prerequisites instead of night-run preflight
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  def "nu-complete togi events kind" [] {
    [ "backend" "backend.retry" "boot" "boot.leave_reason" "boot.saved_entry" "ccd" "ccd.cap" "ccd.edge" "checking" "checking.chain" "checking.cycle" "checking.step" "combination" "command" "command.reset" "config" "config.loaded" "core" "core.phase" "crash" "crash.detected" "day" "day.answer" "day.applied" "day.boot_start" "day.checkpoint" "day.clean_stop" "day.event" "day.fault" "day.freeze" "day.hold" "day.imported" "day.interval" "day.offsets_changed" "day.record" "day.step" "day.unclean_end" "day.veto" "deadend" "deepening" "deepening.round" "defect" "defect.answered" "defect.found" "exposure" "exposure.observed" "failure" "failure.carried" "host" "host.ranking" "hunt" "hunt.end" "hunt.group" "hunt.skipped" "hunt.start" "journal" "journal.torn" "mce" "night" "night.plan" "night.qualification" "night.reproduction" "preflight" "preflight.check" "profile" "profile.applied" "profile.change" "profile.restored" "session" "session.archived" "session.baseline" "session.carried" "session.context" "session.imported" "session.notice" "session.start" "session.warning" "shutdown" "smu" "smu.error" "smu.intent" "smu.readback" "smu.write" "state" "state.rebuilt" "task" "task.start" "trial" "trial.carried" "trial.end" "trial.intent" "trial.progress" "trial.sample" "trial.signal" "trial.start" "tuner" "tuner.decision" "tuner.warning" ]
  }

  # Print the journal, one readable line per event
  export extern "togi events" [
    --core: string            # Only events naming core N, and the outcomes of trials that load it
    --kind: string@"nu-complete togi events kind" # Only these comma-separated known kinds, or groups such as trial for every trial.* kind
    --trial: string           # Only events of trial ID
    --since: string           # Only events at or after this RFC 3339 time
    --until: string           # Only events before this RFC 3339 time
    --json                    # Print raw, uncolored JSON events
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Reboot into the tuning boot for the night
  export extern "togi night" [
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Restore the day's boot selection
  export extern "togi night-end" [
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Archive the whole session
  export extern "togi reset" [
    --all                     # Archive the session; the next run starts a new one
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Recover after the tuning service reaches its restart limit
  export extern "togi restart-limit" [
    --tuning-boot: path       # GRUB environment or /etc/togi/night.json for retry state and boot selection
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Internal emergency recovery that stops leftover trials and sets every core to offset 0
  export extern "togi emergency-stop" [
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Show the session at a glance
  export extern "togi status" [
    --evidence                # Show exact-profile observations, cap witnesses and recorded night comparisons
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Show the session as a read-only dashboard
  export extern "togi watch" [
    --width: string           # Frame width in columns, 1 to 1000, when stdout is not a terminal
    --height: string          # Frame height in rows, 1 to 1000, when stdout is not a terminal
    --tuning-boot             # Run as the unattended tuning-boot dashboard: ignore q, Q, Ctrl-C and Ctrl-D in every view and leave the quit key out of the help and footer
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Print this message or the help of the given subcommand(s)
  export extern "togi help" [
  ]

  # Start or resume the night's tuning session in the foreground
  export extern "togi help run" [
  ]

  # Observe daily use, answer what happened after an unclean end, or record a crash togi missed
  export extern "togi help day" [
  ]

  # Answer an unclean end; a later answer replaces the previous answer
  export extern "togi help day answer" [
  ]

  # Send pending questions and the morning evidence report to this graphical session
  export extern "togi help day notify" [
  ]

  # Record a crash togi did not observe
  export extern "togi help day record" [
  ]

  # Print a shell completion script
  export extern "togi help completion" [
  ]

  # Check whether this machine is ready for a run
  export extern "togi help doctor" [
  ]

  # Print the journal, one readable line per event
  export extern "togi help events" [
  ]

  # Reboot into the tuning boot for the night
  export extern "togi help night" [
  ]

  # Restore the day's boot selection
  export extern "togi help night-end" [
  ]

  # Archive the whole session
  export extern "togi help reset" [
  ]

  # Recover after the tuning service reaches its restart limit
  export extern "togi help restart-limit" [
  ]

  # Internal emergency recovery that stops leftover trials and sets every core to offset 0
  export extern "togi help emergency-stop" [
  ]

  # Show the session at a glance
  export extern "togi help status" [
  ]

  # Show the session as a read-only dashboard
  export extern "togi help watch" [
  ]

  # Print this message or the help of the given subcommand(s)
  export extern "togi help help" [
  ]

}

export use completions *
