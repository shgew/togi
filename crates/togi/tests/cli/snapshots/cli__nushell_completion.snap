---
source: crates/togi/tests/cli/main.rs
expression: "completion(\"nushell\")"
---
module completions {

  # Finds and tests per-core Curve Optimizer offsets on Zen 5 desktop CPUs
  export extern togi [
    --state-dir: directory    # State directory
    --help(-h)                # Print help
    --version(-V)             # Print version
  ]

  def "nu-complete togi completion shell" [] {
    [ "bash" "zsh" "fish" "nushell" ]
  }

  # Print a shell completion script
  export extern "togi completion" [
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
    shell: string@"nu-complete togi completion shell" # The shell to print the script for
  ]

  def "nu-complete togi events kind" [] {
    [ "backend" "backend.retry" "boot" "boot.leave_reason" "boot.saved_entry" "checking" "checking.chain" "checking.cycle" "checking.step" "combination" "command" "command.reset" "config" "config.loaded" "core" "core.phase" "crash" "crash.detected" "deadend" "deepening" "deepening.round" "defect" "defect.answered" "defect.found" "failure" "failure.carried" "host" "host.ranking" "hunt" "hunt.end" "hunt.group" "hunt.skipped" "hunt.start" "journal" "journal.torn" "mce" "preflight" "preflight.check" "profile" "profile.applied" "profile.change" "profile.restored" "session" "session.archived" "session.baseline" "session.carried" "session.context" "session.notice" "session.start" "session.warning" "shutdown" "smu" "smu.error" "smu.intent" "smu.readback" "smu.write" "state" "state.rebuilt" "trial" "trial.carried" "trial.end" "trial.intent" "trial.progress" "trial.sample" "trial.signal" "trial.start" "tuner" "tuner.decision" "tuner.warning" ]
  }

  # Print the journal, one readable line per event
  export extern "togi events" [
    --core: string            # Only events naming core N, and the outcomes of trials that load it
    --kind: string@"nu-complete togi events kind" # Only these comma-separated known kinds, or groups such as trial for every trial.* kind
    --trial: string           # Only events of trial ID
    --since: string           # Only events at or after this RFC 3339 time
    --until: string           # Only events before this RFC 3339 time
    --json                    # Print raw, uncolored JSON events
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Show the session at a glance
  export extern "togi status" [
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Show the session as a read-only dashboard
  export extern "togi watch" [
    --width: string           # Frame width in columns when stdout is not a terminal
    --height: string          # Frame height in rows when stdout is not a terminal
    --state-dir: directory    # State directory
    --help(-h)                # Print help (see more with '--help')
  ]

  # Print this message or the help of the given subcommand(s)
  export extern "togi help" [
  ]

  # Print a shell completion script
  export extern "togi help completion" [
  ]

  # Print the journal, one readable line per event
  export extern "togi help events" [
  ]

  # Show the session at a glance
  export extern "togi help status" [
  ]

  # Show the session as a read-only dashboard
  export extern "togi help watch" [
  ]

  # Print this message or the help of the given subcommand(s)
  export extern "togi help help" [
  ]

}

export use completions *
