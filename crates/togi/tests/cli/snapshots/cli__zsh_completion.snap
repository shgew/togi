---
source: crates/togi/tests/cli/mod.rs
expression: "completion(\"zsh\")"
---
#compdef togi

autoload -U is-at-least

_togi() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_togi_commands" \
"*::: :->togi" \
&& ret=0
    case $state in
    (togi)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:togi-command-$line[1]:"
        case $line[1] in
            (run)
_arguments "${_arguments_options[@]}" : \
'--config=[JSON configuration file \[default\: /etc/togi/config.json\]]:path:_files' \
'--tuning-boot=[Run as the tuning boot service\: use the GRUB environment to persist a leave reason before restoring the day'\''s boot selection, and reboot after a boot loop]:file:_files' \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(day)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
":: :_togi__subcmd__day_commands" \
"*::: :->day" \
&& ret=0

    case $state in
    (day)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:togi-day-command-$line[1]:"
        case $line[1] in
            (answer)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help]' \
'--help[Print help]' \
':boot -- Full boot ID shown in the pending question:_default' \
':answer -- What happened\: frozen, graphics, power-off or unsure:_default' \
&& ret=0
;;
(notify)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(reapply)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(pause)
_arguments "${_arguments_options[@]}" : \
'--until=[Pause until the next occurrence of this local time (HH\:MM)]:HH:MM:_default' \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help]' \
'--help[Print help]' \
'::duration -- Pause for a positive duration, such as 30m, 2h or 1h30m; omitted means until cold boot:_default' \
&& ret=0
;;
(resume)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(freeze)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(unfreeze)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_togi__subcmd__day__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:togi-day-help-command-$line[1]:"
        case $line[1] in
            (answer)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(notify)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(reapply)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(pause)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(resume)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(freeze)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(unfreeze)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell -- The shell to print the script for:(bash zsh fish nushell)' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'--config=[JSON configuration file \[default\: /etc/togi/config.json\]]:path:_files' \
'--state-dir=[State directory]:path:_files -/' \
'--day[Check day-observation prerequisites instead of night-run preflight]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(night)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(reset)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'--all[Archive the session; the next run starts a new one]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(restart-limit)
_arguments "${_arguments_options[@]}" : \
'--tuning-boot=[GRUB environment file for retry state and boot selection]:file:_files' \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(emergency-stop)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'--evidence[Show exact-profile observations, cap witnesses and recorded night comparisons]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(watch)
_arguments "${_arguments_options[@]}" : \
'--width=[Frame width in columns, 1 to 1000, when stdout is not a terminal]:columns:' \
'--height=[Frame height in rows, 1 to 1000, when stdout is not a terminal]:rows:' \
'--state-dir=[State directory]:path:_files -/' \
'--tuning-boot[Run as the unattended tuning-boot dashboard\: ignore q, Q, Ctrl-C and Ctrl-D in every view and leave the quit key out of the help and footer]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_togi__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:togi-help-command-$line[1]:"
        case $line[1] in
            (run)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(day)
_arguments "${_arguments_options[@]}" : \
":: :_togi__subcmd__help__subcmd__day_commands" \
"*::: :->day" \
&& ret=0

    case $state in
    (day)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:togi-help-day-command-$line[1]:"
        case $line[1] in
            (answer)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(notify)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(reapply)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(pause)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(resume)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(freeze)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(unfreeze)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
(completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(night)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(reset)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(restart-limit)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(emergency-stop)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(watch)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_togi_commands] )) ||
_togi_commands() {
    local commands; commands=(
'run:Start or resume the night'\''s tuning session in the foreground' \
'day:Apply the permitted profile, observe daily use, pause or freeze, and report crashes' \
'completion:Print a shell completion script' \
'doctor:Check whether this machine is ready for a run' \
'night:Reboot into the tuning boot for the night' \
'reset:Archive the whole session' \
'restart-limit:Recover after the tuning service reaches its restart limit' \
'emergency-stop:Internal emergency recovery that stops leftover trials and sets every core to offset 0' \
'status:Show the session at a glance' \
'watch:Show the session dashboard with rootless day controls' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'togi commands' commands "$@"
}
(( $+functions[_togi__subcmd__completion_commands] )) ||
_togi__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'togi completion commands' commands "$@"
}
(( $+functions[_togi__subcmd__day_commands] )) ||
_togi__subcmd__day_commands() {
    local commands; commands=(
'answer:Answer an unclean end; a later answer replaces the previous answer' \
'notify:Send pending questions and the morning evidence report to this graphical session' \
'reapply:Reapply the committed profile after system resume; used by the system sleep hook' \
'pause:Keep every core at stock until the next cold boot or a deadline' \
'resume:End the pause early and verify committed-profile reapplication' \
'freeze:Keep the committed profile and prevent promotions, never safety retreats' \
'unfreeze:Lift the promotion freeze' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'togi day commands' commands "$@"
}
(( $+functions[_togi__subcmd__day__subcmd__answer_commands] )) ||
_togi__subcmd__day__subcmd__answer_commands() {
    local commands; commands=()
