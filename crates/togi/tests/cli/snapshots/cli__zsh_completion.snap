---
source: crates/togi/tests/cli/main.rs
expression: "completion(\"zsh\")"
---
#compdef togi

autoload -U is-at-least

_togi() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_togi_commands" \
"*::: :->togi" \
&& ret=0
    case $state in
    (togi)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:togi-command-$line[1]:"
        case $line[1] in
            (run)
_arguments "${_arguments_options[@]}" : \
'--config=[JSON configuration file \[default\: /etc/togi/config.json\]]:path:_files' \
'(--first-result)--cycles=[Stop after N clean cycles, each a passed full cycle ending at or after phase 2'\''s confirmation cycle (default endless)]:N:_default' \
'--tuning-boot=[Run as the tuning boot service\: persist a leave reason before clearing the saved boot entry in this GRUB environment file, and reboot after a boot loop]:file:_files' \
'--state-dir=[State directory]:path:_files -/' \
'--first-result[Stop once the BIOS profile is first confirmed, after phase 1'\''s passed cycle and before phase 2 moves a core]' \
'--no-tui[Print one line per event instead of the dashboard on a terminal]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(day)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell -- The shell to print the script for:(bash zsh fish nushell)' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'--config=[JSON configuration file \[default\: /etc/togi/config.json\]]:path:_files' \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(events)
_arguments "${_arguments_options[@]}" : \
'--core=[Only events naming core N, and the outcomes of trials that load it]:N:' \
'*--kind=[Only these comma-separated known kinds, or groups such as trial for every trial.* kind]:kinds:_sequence compadd - backend backend.retry boot boot.leave_reason boot.saved_entry checking checking.chain checking.cycle checking.step combination command command.reset config config.loaded core core.phase crash crash.detected day day.boot_start day.checkpoint day.clean_stop day.offsets_changed day.unclean_end deadend deepening deepening.round defect defect.answered defect.found failure failure.carried host host.ranking hunt hunt.end hunt.group hunt.skipped hunt.start journal journal.torn mce preflight preflight.check profile profile.applied profile.change profile.restored session session.archived session.baseline session.carried session.context session.notice session.start session.warning shutdown smu smu.error smu.intent smu.readback smu.write state state.rebuilt trial trial.carried trial.end trial.intent trial.progress trial.sample trial.signal trial.start tuner tuner.decision tuner.warning' \
'--trial=[Only events of trial ID]:ID:' \
'--since=[Only events at or after this RFC 3339 time]:time:' \
'--until=[Only events before this RFC 3339 time]:time:' \
'--state-dir=[State directory]:path:_files -/' \
'--json[Print raw, uncolored JSON events]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(reset)
_arguments "${_arguments_options[@]}" : \
'--core=[Reset core N\: clear its failure point and every combination that includes it, and restart its search from the baseline]:N:' \
'--config=[JSON configuration file \[default\: /etc/togi/config.json\]]:path:_files' \
'--state-dir=[State directory]:path:_files -/' \
'--all[Archive the session; the next run starts a new one]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(restart-limit)
_arguments "${_arguments_options[@]}" : \
'--tuning-boot=[GRUB environment file for retry state and the saved tuning entry]:file:_files' \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(emergency-stop)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(watch)
_arguments "${_arguments_options[@]}" : \
'--width=[Frame width in columns, 1 to 1000, when stdout is not a terminal]:columns:' \
'--height=[Frame height in rows, 1 to 1000, when stdout is not a terminal]:rows:' \
'--state-dir=[State directory]:path:_files -/' \
'--tuning-boot[Run as the unattended tuning-boot dashboard\: ignore q, Q, Ctrl-C and Ctrl-D in every view and leave the quit key out of the help and footer]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_togi__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:togi-help-command-$line[1]:"
        case $line[1] in
            (run)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(day)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(events)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(reset)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(restart-limit)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(emergency-stop)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(watch)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_togi_commands] )) ||
_togi_commands() {
    local commands; commands=(
'run:Start or resume the tuning session in the foreground' \
'day:Observe normal use without applying offsets or starting workloads' \
'completion:Print a shell completion script' \
'doctor:Check whether this machine is ready for a run' \
'events:Print the journal, one readable line per event' \
'reset:Reset one core, or archive the whole session' \
'restart-limit:Recover after the tuning service reaches its restart limit' \
'emergency-stop:Internal emergency recovery that stops leftover trials and sets every core to offset 0' \
'status:Show the session at a glance' \
'watch:Show the session as a read-only dashboard' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'togi commands' commands "$@"
}
(( $+functions[_togi__subcmd__completion_commands] )) ||
_togi__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'togi completion commands' commands "$@"
}
(( $+functions[_togi__subcmd__day_commands] )) ||
_togi__subcmd__day_commands() {
    local commands; commands=()
    _describe -t commands 'togi day commands' commands "$@"
}
(( $+functions[_togi__subcmd__doctor_commands] )) ||
_togi__subcmd__doctor_commands() {
    local commands; commands=()
    _describe -t commands 'togi doctor commands' commands "$@"
}
(( $+functions[_togi__subcmd__emergency-stop_commands] )) ||
_togi__subcmd__emergency-stop_commands() {
    local commands; commands=()
    _describe -t commands 'togi emergency-stop commands' commands "$@"
}
(( $+functions[_togi__subcmd__events_commands] )) ||
_togi__subcmd__events_commands() {
    local commands; commands=()
    _describe -t commands 'togi events commands' commands "$@"
}
(( $+functions[_togi__subcmd__help_commands] )) ||
_togi__subcmd__help_commands() {
    local commands; commands=(
'run:Start or resume the tuning session in the foreground' \
'day:Observe normal use without applying offsets or starting workloads' \
'completion:Print a shell completion script' \
'doctor:Check whether this machine is ready for a run' \
'events:Print the journal, one readable line per event' \
'reset:Reset one core, or archive the whole session' \
'restart-limit:Recover after the tuning service reaches its restart limit' \
'emergency-stop:Internal emergency recovery that stops leftover trials and sets every core to offset 0' \
'status:Show the session at a glance' \
'watch:Show the session as a read-only dashboard' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'togi help commands' commands "$@"
}
(( $+functions[_togi__subcmd__help__subcmd__completion_commands] )) ||
_togi__subcmd__help__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'togi help completion commands' commands "$@"
}
(( $+functions[_togi__subcmd__help__subcmd__day_commands] )) ||
_togi__subcmd__help__subcmd__day_commands() {
    local commands; commands=()
    _describe -t commands 'togi help day commands' commands "$@"
}
(( $+functions[_togi__subcmd__help__subcmd__doctor_commands] )) ||
_togi__subcmd__help__subcmd__doctor_commands() {
    local commands; commands=()
    _describe -t commands 'togi help doctor commands' commands "$@"
}
(( $+functions[_togi__subcmd__help__subcmd__emergency-stop_commands] )) ||
_togi__subcmd__help__subcmd__emergency-stop_commands() {
    local commands; commands=()
    _describe -t commands 'togi help emergency-stop commands' commands "$@"
}
(( $+functions[_togi__subcmd__help__subcmd__events_commands] )) ||
_togi__subcmd__help__subcmd__events_commands() {
    local commands; commands=()
    _describe -t commands 'togi help events commands' commands "$@"
}
(( $+functions[_togi__subcmd__help__subcmd__help_commands] )) ||
_togi__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'togi help help commands' commands "$@"
}
(( $+functions[_togi__subcmd__help__subcmd__reset_commands] )) ||
_togi__subcmd__help__subcmd__reset_commands() {
    local commands; commands=()
    _describe -t commands 'togi help reset commands' commands "$@"
}
(( $+functions[_togi__subcmd__help__subcmd__restart-limit_commands] )) ||
_togi__subcmd__help__subcmd__restart-limit_commands() {
    local commands; commands=()
    _describe -t commands 'togi help restart-limit commands' commands "$@"
}
(( $+functions[_togi__subcmd__help__subcmd__run_commands] )) ||
_togi__subcmd__help__subcmd__run_commands() {
    local commands; commands=()
    _describe -t commands 'togi help run commands' commands "$@"
}
(( $+functions[_togi__subcmd__help__subcmd__status_commands] )) ||
_togi__subcmd__help__subcmd__status_commands() {
    local commands; commands=()
    _describe -t commands 'togi help status commands' commands "$@"
}
(( $+functions[_togi__subcmd__help__subcmd__watch_commands] )) ||
_togi__subcmd__help__subcmd__watch_commands() {
    local commands; commands=()
    _describe -t commands 'togi help watch commands' commands "$@"
}
(( $+functions[_togi__subcmd__reset_commands] )) ||
_togi__subcmd__reset_commands() {
    local commands; commands=()
    _describe -t commands 'togi reset commands' commands "$@"
}
(( $+functions[_togi__subcmd__restart-limit_commands] )) ||
_togi__subcmd__restart-limit_commands() {
    local commands; commands=()
    _describe -t commands 'togi restart-limit commands' commands "$@"
}
(( $+functions[_togi__subcmd__run_commands] )) ||
_togi__subcmd__run_commands() {
    local commands; commands=()
    _describe -t commands 'togi run commands' commands "$@"
}
(( $+functions[_togi__subcmd__status_commands] )) ||
_togi__subcmd__status_commands() {
    local commands; commands=()
    _describe -t commands 'togi status commands' commands "$@"
}
(( $+functions[_togi__subcmd__watch_commands] )) ||
_togi__subcmd__watch_commands() {
    local commands; commands=()
    _describe -t commands 'togi watch commands' commands "$@"
}

if [ "$funcstack[1]" = "_togi" ]; then
    _togi "$@"
else
    compdef _togi togi
fi
