---
source: crates/togi/tests/cli/main.rs
expression: "completion(\"zsh\")"
---
#compdef togi

autoload -U is-at-least

_togi() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_togi_commands" \
"*::: :->togi" \
&& ret=0
    case $state in
    (togi)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:togi-command-$line[1]:"
        case $line[1] in
            (completion)
_arguments "${_arguments_options[@]}" : \
'--state-dir=[State directory]:path:_files -/' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell -- The shell to print the script for:(bash zsh fish nushell)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_togi__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:togi-help-command-$line[1]:"
        case $line[1] in
            (completion)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_togi_commands] )) ||
_togi_commands() {
    local commands; commands=(
'completion:Print a shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'togi commands' commands "$@"
}
(( $+functions[_togi__subcmd__completion_commands] )) ||
_togi__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'togi completion commands' commands "$@"
}
(( $+functions[_togi__subcmd__help_commands] )) ||
_togi__subcmd__help_commands() {
    local commands; commands=(
'completion:Print a shell completion script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'togi help commands' commands "$@"
}
(( $+functions[_togi__subcmd__help__subcmd__completion_commands] )) ||
_togi__subcmd__help__subcmd__completion_commands() {
    local commands; commands=()
    _describe -t commands 'togi help completion commands' commands "$@"
}
(( $+functions[_togi__subcmd__help__subcmd__help_commands] )) ||
_togi__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'togi help help commands' commands "$@"
}

if [ "$funcstack[1]" = "_togi" ]; then
    _togi "$@"
else
    compdef _togi togi
fi
