# Generated by just fit; do not hand-edit.
# Whole-trial bootstrap: index=2 (0=all facts), seed=263, starts=45, negative_log_likelihood=12.5
# Fitted: isolated/resident regime edges, shared rate/growth/near hazard, per-core flat hazard,
# supported workload overrides, idle edges, and layered R7 CCD joints.
# Unsupported edges stay -50; unobserved idle exposure cannot identify idle hazards.
# Fixed: onset boost=0, joint delay=0; default signals/MCE/reset.
# Constrained bootstrap: R7 work cores=[0 1] duration=120s depth=-24 n=45 k=5
cores = 2
facts = "../facts/extract.jsonl.gz"

[bios_context]
