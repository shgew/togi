set shell := ["bash", "-euo", "pipefail", "-c"]

# Run the tests
test *args:
    go test ./... "$@"

# Prove decisions are unchanged from a base revision
[group('run')]
same base="origin/main" *args: _dev-shell
    dir=$(mktemp -d); trap 'rm -rf "$dir"' EXIT
    go run ./tools/bench --same "$dir" "${@:2}"

# Prove a smaller selection
smoke base="origin/main" *args:
    go run ./tools/bench --smoke
